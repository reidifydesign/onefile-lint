{
  "name": "onefile-lint",
  "version": "0.1.0",
  "description": "Checks that an agent-made single-file HTML page is still one portable file: no remote dependencies, size, print and offline use. Optional accessibility-adjacent extras.",
  "type": "module",
  "bin": {
    "onefile-lint": "bin/onefile-lint.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "catalogue",
    "awesome",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "catalogue": "node scripts/build-catalogue.mjs",
    "corpus": "node scripts/corpus.mjs",
    "list:refresh": "node scripts/refresh-list.mjs"
  },
  "keywords": [
    "html",
    "single-file",
    "lint",
    "offline",
    "portability",
    "agents",
    "artifacts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reidifydesign/onefile-lint.git"
  },
  "homepage": "https://reidify.design/open-source"
}
